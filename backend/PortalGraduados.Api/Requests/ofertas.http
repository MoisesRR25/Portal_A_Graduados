@base = http://localhost:8080/api/ofertas

### 1. Publicar oferta, empresa aprobada (201)
# @name oferta
POST {{base}}
Content-Type: application/json

{
  "idEmpresa": 1,
  "cargo": "Desarrollador backend .NET",
  "area": "Desarrollo de software",
  "ubicacion": "San Salvador",
  "descripcionCorta": "Desarrollo de APIs con ASP.NET Core",
  "descripcion": "Diseno y mantenimiento de APIs REST con ASP.NET Core y PostgreSQL.",
  "requisitos": "Conocimientos de C#, SQL y Git. Deseable Docker.",
  "rangoSalarial": "$800 - $1200",
  "modalidad": "Hibrido",
  "clasificacionOportunidad": "Empleo",
  "fechaCierre": "2027-03-31T23:59:00"
}

